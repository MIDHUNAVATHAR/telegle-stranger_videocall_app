# ==============================================================================
# Donkey Play — Root Environment Template
# ==============================================================================

# Backend API Configuration (apps/api)
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
# MongoDB Cloud (Atlas) or local connection string:
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/donkey_play?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/donkey_play?retryWrites=true&w=majority
MONGODB_DEBUG=false

# Redis Configuration (apps/api)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_ACCESS_SECRET=donkey_play_super_secret_jwt_access_key_32_chars
JWT_REFRESH_SECRET=donkey_play_super_secret_jwt_refresh_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Third-Party Integrations
BREVO_API_KEY=
BREVO_SENDER_EMAIL=otp@donkeyplay.com
BREVO_SENDER_NAME=Donkey Play Verification

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay & RazorpayX (Payments & Instant UPI Payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER= # RazorpayX source business account number for UPI payouts (e.g. 2323230032943283)

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
