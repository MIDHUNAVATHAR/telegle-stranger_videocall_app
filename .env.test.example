# ==============================================================================
# Donkey Play — Backend Testing & Local Development Environment Template
# ==============================================================================
# Note: For production and local development, copy this to apps/api/.env
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=test
PORT=5000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/donkey_play_test
MONGODB_DEBUG=false

# Redis Configuration (Presence, Queues, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# JWT Secret Keys & Token Lifespans
JWT_ACCESS_SECRET=test_access_secret_super_secure_key_at_least_32_chars_long
JWT_REFRESH_SECRET=test_refresh_secret_super_secure_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# Brevo API (Transactional Email OTP)
BREVO_API_KEY=xkeysib-mock-test-key-00000000000000000000000000000000
BREVO_SENDER_EMAIL=otp@donkeyplay.com
BREVO_SENDER_NAME=Donkey Play Verification

# Google Identity Services / OAuth 2.0
GOOGLE_CLIENT_ID=123456789012-mockclientidfortesting.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-mockclientsecretfortesting

# Cloudinary (Avatar Storage)
CLOUDINARY_CLOUD_NAME=mock-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=mock-cloudinary-secret-abcdef123456

# Razorpay (Coin Purchases)
RAZORPAY_KEY_ID=rzp_test_mockKeyId12345
RAZORPAY_KEY_SECRET=mockRazorpayKeySecretAbcdef
RAZORPAY_WEBHOOK_SECRET=mockRazorpayWebhookSecret98765

# RazorpayX (UPI Payouts)
RAZORPAYX_ACCOUNT_NUMBER=2323230000000000
RAZORPAYX_API_KEY=mockRazorpayXApiKey123
RAZORPAYX_API_SECRET=mockRazorpayXApiSecret456
RAZORPAYX_WEBHOOK_SECRET=mockRazorpayXWebhookSecret789

# STUN / WebRTC Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Business Rules & Safety Limits
MATCH_COIN_PRICE=1
MIN_CALL_DURATION_SECONDS=5
WITHDRAWAL_MIN_AMOUNT_PAISE=50000
REPORTS_BAN_THRESHOLD=5
REPORTS_BAN_WINDOW_SECONDS=3600
BAN_DURATION_SECONDS=86400

# Platform Commission & Referral Rewards
platform_commision_gift=30
PLATFORM_COMMISSION_GIFT=30
referral_coins_amount=10
REFERRAL_REWARD_COINS=10

