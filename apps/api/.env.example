# Donkey Play — API Environment Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017/donkey_play
MONGODB_DEBUG=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_ACCESS_SECRET=donkey_play_super_secret_jwt_access_key_32_chars
JWT_REFRESH_SECRET=donkey_play_super_secret_jwt_refresh_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BREVO_API_KEY=
BREVO_SENDER_EMAIL=otp@donkeyplay.com
BREVO_SENDER_NAME=Donkey Play Verification

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MATCH_COIN_PRICE=1
MIN_CALL_DURATION_SECONDS=5
REPORTS_BAN_THRESHOLD=5
REPORTS_BAN_WINDOW_SECONDS=3600
BAN_DURATION_SECONDS=86400
